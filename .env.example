# voicezero config + secrets — TEMPLATE ONLY (placeholders, never real keys).
#
# Two safe ways to provide these at runtime:
#   1) Doppler (preferred): bind once with `doppler setup`, then run via
#        doppler run -- python agent.py --selftest
#      Real keys live in Doppler / your Command Center Keys panel, not on disk.
#   2) Local dev: copy this file to `.env` (already gitignored) and paste keys.
#
# NEVER commit a real gsk_ key. NEVER paste one into a chat or the public site.

# Get a free key at https://console.groq.com/keys
# Comma-separated keys, one per SEPARATE Groq account, each get their own free
# daily pool -> more keys = more free headroom. The agent rotates across keys
# AND models automatically (LLM and cloud STT both).
GROQ_API_KEYS=gsk_account1_xxx,gsk_account2_xxx

# STT backend:
#   auto   (default) best AVAILABLE, falling through on failure:
#          sarvam (if SARVAM_API_KEY) -> groq large-v3 (if a Groq key) -> local.
#          A LIVE call already has a Groq key, so it transcribes on Groq's
#          large-v3-turbo automatically (much better Hindi/accents than local
#          'small'); --loopback (no key) stays fully on your CPU.
#   local  faster-whisper on THIS machine. Free, offline, PRIVATE (audio never
#          leaves the device). Set this if on-device STT matters more than accuracy.
#   groq   Groq cloud Whisper only (production server, nothing local).
#   sarvam Sarvam Saarika only (best Indian/code-switch STT; needs SARVAM_API_KEY).
# NOTE: 'auto'/'groq'/'sarvam' send the utterance audio to a cloud API. Use 'local'
# to keep STT 100% on-device.
STT_BACKEND=auto

# Optional tuning
WHISPER_MODEL=small                    # tiny/base/small/medium (local backend)
WHISPER_LANG=en                        # default STT language; personas override via
                                       # "stt_lang" (Hinglish persona uses "hi").
                                       # Use "auto" to let Whisper detect per turn.
GROQ_STT_MODEL=whisper-large-v3-turbo  # used by the groq STT backend

# Optional premium TTS + STT (Indian languages). No package needed — pure REST.
# One key enables BOTH the sarvam TTS voice and Saarika STT. Free trial credits,
# then paid, so it is opt-in and never a default; unset -> everything uses the
# free edge-tts voices and local/groq STT.
# SARVAM_API_KEY=sk_xxx
# SARVAM_STT_MODEL=saarika:v2

# Cross-call memory (memory.py). Salt for hashing the caller number into the
# caller_hash that keys remembered context. Keep this IDENTICAL to the value
# dental-receptionist uses so a caller_hash means the same caller in both repos.
# Provide via Doppler (preferred), never a real value committed here.
CALLER_NUMBER_SALT=change-me-shared-with-dental-receptionist
# VOICEZERO_MEMORY_DB=caller_memory.db  # optional: path to the SQLite store
